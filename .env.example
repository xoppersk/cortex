# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM providers (optional; mock provider used if absent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (optional; billing endpoints return 501 without)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (optional; invites log to console without)
RESEND_API_KEY=

# Demo mode (no keys needed, in-memory store)
DEMO_MODE=false
